# ---------------------------------------------------------------------------
# Django 기본
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=여기에-50자-이상-랜덤-문자열
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backendkingjinho.shop

# 프론트엔드 출처 화이트리스트 (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# 인증 / 인가
# ---------------------------------------------------------------------------
# 데모 시연 모드.
#   1 : Authorization 헤더 없는 요청을 데모 계정으로 인증한다.
#       이렇게 인증된 요청은 is_demo=True 사업장에만 접근할 수 있다.
#       프론트엔드에 로그인 플로우가 붙기 전까지 부스 시연용으로 사용한다.
#   0 : 모든 요청에 Authorization: Token <key> 를 요구한다. 실서비스 값.
DEMO_MODE=1
DEMO_USERNAME=demo

# ---------------------------------------------------------------------------
# 암호화 (주민등록번호 등 민감정보)
# ---------------------------------------------------------------------------
# 생성:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# 외부 연동
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=20

# CODEF (홈택스 스크래핑). mock 이면 외부 호출 없이 목 데이터를 쓴다.
CODEF_MODE=mock
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=

# 서울시 열린데이터광장 상권분석 API
SEOUL_DATA_API_KEY=

# ---------------------------------------------------------------------------
# 이메일 (세무사 리포트 발송)
# ---------------------------------------------------------------------------
# 미설정 시 콘솔 백엔드로 동작한다(실제 발송 안 됨).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
