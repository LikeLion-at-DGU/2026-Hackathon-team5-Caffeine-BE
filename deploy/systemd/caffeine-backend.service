[Unit]
Description=Gunicorn daemon for Caffeine Backend
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/2026-Hackathon-team5-Caffeine-BE
EnvironmentFile=/home/ubuntu/2026-Hackathon-team5-Caffeine-BE/.env
ExecStart=/home/ubuntu/2026-Hackathon-team5-Caffeine-BE/venv/bin/gunicorn \
          --config /home/ubuntu/2026-Hackathon-team5-Caffeine-BE/deploy/gunicorn.conf.py \
          config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
